BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
DATABASE_URL=sqlite:///./finsync_intelligence.db
MARKET_DATA_MODE=simulated
MARKET_DATA_PROVIDER=upstox
MARKET_DATA_API_KEY=
UPSTOX_ACCESS_TOKEN=
UPSTOX_INSTRUMENT_MASTER_URL=https://assets.upstox.com/market-quote/instruments/exchange/complete.json.gz
INSTRUMENT_REFRESH_HOURS=20
QUOTE_CACHE_SECONDS=15
CANDLE_CACHE_SECONDS=900
MARKET_REQUEST_TIMEOUT_SECONDS=8
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=12
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
SEMANTIC_RETRIEVAL_ENABLED=true
FRONTEND_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
